---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Hidden page: the redirect target after submitting /feedback.

// All copy lives here so the page can be translated in one place.
const copy = {
  lang: 'en',
  title: 'Feedback received · QWER',
  description: 'Thank you for your feedback on the QWER AI training.',
  eyebrow: 'Feedback · AI training',
  headingLine1: 'Thank you.',
  headingLine2: 'De rest volgt.',
  body: 'Your feedback helps us make the next training better.',
  backLink: 'Back to the homepage',
};
---

<Layout title={copy.title} description={copy.description} lang={copy.lang} noindex>
  <Nav />
  <main>
    <section class="bg-paper px-6 py-24 md:py-32">
      <div class="mx-auto flex max-w-xl flex-col items-center gap-6 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-gray">{copy.eyebrow}</p>
        <h1 class="font-heading text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl">
          {copy.headingLine1}<br />
          <span class="text-teal" lang="nl">{copy.headingLine2}</span>
        </h1>
        <p class="max-w-[42ch] font-body text-base text-gray sm:text-lg">{copy.body}</p>
        <a
          href="/"
          class="w-full rounded-lg border border-charcoal/20 px-7 py-3.5 font-body text-sm font-medium text-ink transition-colors hover:border-charcoal/40 sm:w-auto"
        >
          {copy.backLink}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
